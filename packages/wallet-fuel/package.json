{
  "name": "@openagentpay/wallet-fuel",
  "version": "0.1.0-alpha.0",
  "description": "Fuel (FuelVM) wallet connector for OpenAgentPay — secp256k1 over sha256, b256 (32-byte hex) address derived from sha256(pubkey), ETH (9dp) + USDC. Offline-real signer, deferred broadcast.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": ["fuel", "fuelvm", "fuel-pay", "openagentpay", "non-evm", "secp256k1", "b256", "wallet-connector"],
  "dependencies": {
    "@openagentpay/core": "workspace:*",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.0",
    "@scure/bip39": "^1.5.0"
  },
  "devDependencies": {
    "@openagentpay/conformance": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
