{
  "name": "@openagentpay/wallet-ronin",
  "version": "0.1.0-alpha.0",
  "description": "Ronin (Axie Infinity) self-custodial EVM wallet connector for OpenAgentPay. Implements x402 / EIP-3009 transferWithAuthorization against USDC on Ronin Saigon testnet (chainId 2021). Ronin displays addresses with a ronin: prefix but uses standard 0x EVM addresses under the hood.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@openagentpay/core": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@openagentpay/conformance": "workspace:*",
    "vitest": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "keywords": ["ronin", "ronin-saigon", "axie", "evm", "x402", "eip-3009", "usdc", "wallet-connector"]
}
